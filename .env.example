# --- Database (Neon Postgres) ---
# Create a free project at https://neon.tech, then copy both connection
# strings it gives you:
#   - DATABASE_URL: the pooled connection string (used at runtime)
#   - DIRECT_URL:   the direct, non-pooled connection string (used by
#                   `prisma db push` / migrations)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Email notifications (Resend) ---
# Sign up free at https://resend.com, verify a sending domain (or use
# their onboarding@resend.dev test address), and grab an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Iron Rose Tattoo Co. <onboarding@resend.dev>"
# Where new booking inquiries get emailed to.
BOOKING_NOTIFY_EMAIL="you@ironrosetattoo.com"
